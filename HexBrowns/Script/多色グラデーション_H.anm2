--information:多色グラデーション_H v1.10 by HexBrowns
--label:HexScript
--track@strength:強さ,0,100,100,0.1
--track@center_x:中心X,-5000,5000,0,0.1
--track@center_y:中心Y,-5000,5000,0,0.1
--track@angle:角度,-3600,3600,0,0.01
--track@gradient_w:幅,0,2000,100,1
--select@blend_mode:合成モード,通常=0,加算=1,減算=2,乗算=3,スクリーン=4,オーバーレイ=5,比較(明)=6,比較(暗)=7,輝度=8,色差=9,陰影=10,明暗=11,差分=12
--select@gradient_type:形状,線形=0,円形=1,矩形=2,凸形=3,角丸矩形=4,円形ループ=5,矩形ループ=6,凸形ループ=7,角丸矩形ループ=8
--select@color_space:色空間=1,sRGB=0,Linear sRGB=1,HSV=2,HSL=3,L*a*b=4,LCh=5,Oklab=6,Oklch=7
--select@interp_dir:補間経路,短経路=0,長経路=1
--color@color1:開始色,0xffffff
--color@color2:終了色,0x000000
--track@alpha1:開始色透明度,0,100,0,0.01
--track@alpha2:終了色透明度,0,100,0,0.01
--select@color_count:色数=2,2色=2,3色=3,4色=4,5色=5
--check@even_stops:位置を等間隔にする,1
--hide@even_stops:color_count<3
--color@color_mid1:中間色1,0xff0000
--hide@color_mid1:color_count<3
--track@alpha_mid1:中間色1透明度,0,100,0,0.01
--hide@alpha_mid1:color_count<3
--track@pos_mid1:中間色1位置,0,100,25,0.01
--hide@pos_mid1:color_count<3
--hide@pos_mid1:even_stops==1
--color@color_mid2:中間色2,0x00ff00
--hide@color_mid2:color_count<4
--track@alpha_mid2:中間色2透明度,0,100,0,0.01
--hide@alpha_mid2:color_count<4
--track@pos_mid2:中間色2位置,0,100,50,0.01
--hide@pos_mid2:color_count<4
--hide@pos_mid2:even_stops==1
--color@color_mid3:中間色3,0x0000ff
--hide@color_mid3:color_count<5
--track@alpha_mid3:中間色3透明度,0,100,0,0.01
--hide@alpha_mid3:color_count<5
--track@pos_mid3:中間色3位置,0,100,75,0.01
--hide@pos_mid3:color_count<5
--hide@pos_mid3:even_stops==1
--select@w_basis:幅の基準=0,ピクセル=0,画像サイズ=1
--track@gradient_pct:幅(%),0,1000,100,0.1
--hide@gradient_w:w_basis==1
--hide@gradient_pct:w_basis==0
--track@grad_steps:段数(0で連続),0,256,0,1
--select@grad_dither:ディザ=0,なし=0,Bayer=1,ノイズ=2

-- 多色グラデーション_H v1.10
--
-- 原作: グラデーション+ v1.1.0 by azurite（Script/グラデーション+.anm2、CC0-1.0）。
-- CC0 なので改変・再配布の制約は無い。原作のファイルはそのまま残してある。
--
-- 原作から変えたところ
--   1. 色を 2 色から最大 5 色にした（色数 / 中間色1〜3 / 各透明度 / 各位置）。
--      色の並びは 開始色 → 中間色1 → 中間色2 → 中間色3 → 終了色。
--      使わない中間色と位置は --hide@ で隠す（位置は「等間隔」のときも隠す）
--   2. 中間色の位置はトラックなので動かせる。位置は形状が作る 0〜100% の線形な位置で数える。
--      前の色より手前に置いた位置は前の色の位置に揃える（CSS のグラデーションと同じ扱い）
--   3. 区間ごとに原作と同じ smoothstep の補間を掛ける（同じ作者の MultiGradient と同じ考え方）。
--      そのために形状の関数は smoothstep を掛ける前の値を返すようにした（linstep）
--   4. obj.copybuffer("obj", "tmp") を lua.txt の正式名 "object" / "tempbuffer" に直した
--   5. v1.01: 強さ < 100 で半透明の縁のアルファが減るのを直した。原作は仮想バッファの素材の上に
--      「素材にグラデーションを重ねたもの」を重ねるので、半透明の画素で素材を二重に数え、
--      アルファが a x (強さ + (1 - 強さ) x a) に減り、色もグラデーション側へ寄っていた。
--      素材を一度不透明（ストレートの色・α 1、ps_opaque）にしてから原作と同じ流れで合成し、
--      最後に合成結果のストレートの色へ素材のアルファを掛け直す（ps_restore、原作は "mask"）。
--      - 不透明な画素（a = 1）は、どの合成モード・強さでも原作と同じ
--      - 強さ 100・合成モード 通常・色が不透明なら、半透明の画素も原作と同じ
--      - それ以外の半透明の画素は、アルファが素材のまま保たれ、合成モード 通常 では色が
--        lerp(素材の色, 素材の色にグラデーションを重ねた色, 強さ) になる（原作と見た目が変わる）
--   6. v1.02: 幅の基準 を足した。ピクセル（既定、原作と同じ）は 幅 を画素数で、画像サイズ は 幅(%) を
--      オブジェクトの大きさに対する割合で決める。100% で、形状の 0〜100% がオブジェクトの端から端まで届く:
--        線形          角度の向きに沿って、オブジェクトの一方の端から反対の端まで
--        円形 / 矩形 / 凸形 / 角丸矩形  中心から、いちばん遠い角まで（全体が 0〜100% に収まる）
--        ループ        同じ形のループ無しが 100% で届く幅を 1 周期にする
--      中心は角との距離に入るので、中心X / 中心Y を動かすと幅も変わる（遠い側の角に合わせる）。
--      中心X / 中心Y は画素のまま。ピクセルのときにシェーダーへ渡す定数は v1.01 と同じ
--   7. v1.03: 元の素材の退避（cache）を 1 つの名前にし、読み終えたら縮める。テキストを並べたグループ制御に
--      掛けて描き直すと退避が消えて invalid buffer type になっていた（ps_restore の前の説明）
--   8. v1.10: 段数(0で連続) / ディザ を足した（図形グラデーション_H v2.10 と同じ項目名・同じ式）。
--      段数 n（2 以上）で、形状が作る 0〜100% の位置を n 等分し、段 k（0..n-1）を位置 k/(n-1) の色で塗る
--      （最初の段は開始色、最後の段は終了色。色ではなく位置を区切るので、どの色空間でも各段はその色空間の
--      グラデーションの色になる）。0 と 1 は今までどおりの連続。
--      ディザは段の中心どうしの間で隣の段を混ぜる（混ぜる割合は位置に比例。Bayer は 8x8 の組織的ディザ、
--      ノイズは画素ごとのハッシュ。どちらもオブジェクトの画素の位置で決まる）。段数が 0 / 1 のときは効かない
--      （トラックは --hide@ の条件に書けないので隠していない）
--
-- 互換（保存キー）
--   原作の項目名（強さ〜終了色透明度）と、合成モード / 形状 / 色空間 / 補間経路の
--   選択肢のラベルは 1 文字も変えていない。新しい項目は末尾に足した（v1.02 の 幅の基準 / 幅(%)、
--   v1.10 の 段数(0で連続) / ディザ も末尾。既定の 0 / なし で v1.03 と同じ絵）。
--   .aup2 の effect.name=グラデーション+ を effect.name=多色グラデーション_H に
--   書き換えれば、原作の設定値がそのまま読める（色数は既定の 2色 になる）。
--   2 色のときにシェーダーへ渡る定数の先頭 22 個は原作と同じで、区間は常に
--   「開始色→終了色、0〜1」になるので原作と同じ式に戻る。
--
-- 机上検証: AI/scripts/多色グラデーション_H/verify_gradient.py
-- issue:    AI/scripts/issues/20260915_gradient_plus_vs_multigradient.md
--           AI/scripts/issues/20260916_gradient_plus_strength_thins_semitransparent_edge.md（5）

--[[pixelshader@ps_gradient:
#define PI 3.14159265358979323846
#define TAU (2.0 * PI)

#define SATURATION_THRESHOLD 0
#define CHROMA_THRESHOLD 0.02  // 無彩色か判定するのに使う誤差を考慮した閾値

static const float3 D65_WHITE = float3(0.95047, 1.0, 1.08883);
static const float3 D50_WHITE = float3(0.96422, 1.0, 0.82521);

float mod(float x, float y) {
    return x - y * floor(x / y);
}

float alpha_mix(float alpha1, float alpha2, float t) {
    return clamp(lerp(alpha1, alpha2, t), 0.0, 1.0);
}

// ----------------------------------------------------------------------------
// linear sRGB
// ----------------------------------------------------------------------------
// 参考: https://w.wiki/DBwx
float gamma_decode(float x) {
    return x <= 0.04045 ? x / 12.92 : pow(abs((x + 0.055) / 1.055), 2.4);
}

float3 srgb2linear(float3 x) {
    return float3(gamma_decode(x.r), gamma_decode(x.g), gamma_decode(x.b));
    //return pow(abs(x), float3(2.2));  // 近似
}

// 参考: https://w.wiki/DBx3
float gamma_encode(float x) {
    return x <= 0.0031308 ? 12.92 * x : 1.055 * pow(abs(x), 1.0 / 2.4) - 0.055;
}

float3 linear2srgb(float3 x) {
    return float3(gamma_encode(x.r), gamma_encode(x.g), gamma_encode(x.b));
    //return pow(abs(x), float3(1.0 / 2.2));  // 近似
}

// ----------------------------------------------------------------------------
// HSV
// ----------------------------------------------------------------------------
// 参考: https://w.wiki/DD6A
float3 srgb2hsv(float3 rgb) {
    float max_val = max(rgb.r, max(rgb.g, rgb.b));
    float min_val = min(rgb.r, min(rgb.g, rgb.b));
    float chroma = max_val - min_val;

    float hue = 0;
    float saturation = 0;

    if (chroma == 0) hue = 0;
    else if (max_val == rgb.r) hue = mod((rgb.g - rgb.b) / chroma, 6.0);
    else if (max_val == rgb.g) hue = (rgb.b - rgb.r) / chroma + 2.0;
    else hue = (rgb.r - rgb.g) / chroma + 4.0;
    hue *= 60.0;

    if (max_val == 0) saturation = 0;
    else saturation = chroma / max_val;

    return float3(radians(hue), saturation, max_val);
}

// 参考: https://w.wiki/DD66
float hsv2srgb_f(float3 hsv, float n) {
    float k = mod((n + degrees(hsv.x) / 60.0), 6.0);
    return hsv.z - hsv.z * hsv.y * max(0.0, min(k, min(4.0 - k, 1.0)));
}
float3 hsv2srgb(float3 hsv) {
    return float3(
        hsv2srgb_f(hsv, 5.0),
        hsv2srgb_f(hsv, 3.0),
        hsv2srgb_f(hsv, 1.0)
    );
}

// ----------------------------------------------------------------------------
// HSL
// ----------------------------------------------------------------------------
// 参考: https://w.wiki/DD6A
float3 srgb2hsl(float3 rgb) {
    float max_val = max(rgb.r, max(rgb.g, rgb.b));
    float min_val = min(rgb.r, min(rgb.g, rgb.b));
    float chroma = max_val - min_val;

    float hue = 0;
    if (chroma == 0) hue = 0;
    else if (max_val == rgb.r) hue = mod((rgb.g - rgb.b) / chroma, 6.0);
    else if (max_val == rgb.g) hue = (rgb.b - rgb.r) / chroma + 2.0;
    else hue = (rgb.r - rgb.g) / chroma + 4.0;
    hue *= 60.0;

    float lightness = (max_val + min_val) / 2.0;

    float saturation = 0.0;
    if (lightness != 1.0 && lightness != 0.0) {
        saturation = chroma / (1.0 - abs(2.0 * lightness - 1.0));
    }
    return float3 (radians(hue), saturation, lightness);
}

// 参考: https://w.wiki/DD6D
float hsl2rgb_f(float3 hsl, float n) {
    float k = mod((n + degrees(hsl.x) / 30.0), 12.0);
    float a = hsl.y * min(hsl.z, 1.0 - hsl.z);
    return hsl.z - a * max(-1.0, min(k - 3.0, min(9.0 - k, 1.0)));
}

float3 hsl2srgb(float3 hsl) {
    return float3(
        hsl2rgb_f(hsl, 0.0),
        hsl2rgb_f(hsl, 8.0),
        hsl2rgb_f(hsl, 4.0)
    );
}

float hue_mix(float hue1, float hue2, float t, int interp_dir) {
    float diff = hue2 - hue1;
    switch (interp_dir) {
    case 0:
        if (diff > PI) hue1 += TAU;
        else if (diff < -PI) hue2 += TAU;
        break;
    case 1:
        if (0.0 < diff && diff < PI) hue1 += TAU;
        else if (-PI < diff && diff <= 0.0) hue2 += TAU;
        break;
    }
    float angle = lerp(hue1, hue2, t);
    return mod(mod(angle, TAU) + TAU, TAU);
}

// 各色が無彩色かどうかに基づいてHueを調整し混合する
float adjust_and_mix_hue(float h1, float h2, bool has_valid_hue1, bool has_valid_hue2, float t, int interp_dir) {
    if (has_valid_hue1 && !has_valid_hue2) {
        h2 = h1;
    } else if (!has_valid_hue1 && has_valid_hue2) {
        h1 = h2;
    } else if (!has_valid_hue1 && !has_valid_hue2) {
        h1 = 0.0;
        h2 = 0.0;
    }
    return hue_mix(h1, h2, t, interp_dir);
}

// HSLも同じ補間を行う
float3 hsv_mix(float3 a, float3 b, float x, int interp_dir) {
    bool has_valid_hue1 = a.y > SATURATION_THRESHOLD;
    bool has_valid_hue2 = b.y > SATURATION_THRESHOLD;
    float hue = adjust_and_mix_hue(a.x, b.x, has_valid_hue1, has_valid_hue2, x, interp_dir);
    float3 hsv = float3(hue, lerp(a.yz, b.yz, x));
    return hsv;
}

// ----------------------------------------------------------------------------
// XYZ
// ----------------------------------------------------------------------------
// 参考: http://www.brucelindbloom.com/Eqn_RGB_XYZ_Matrix.html
float3 linear2d50xyz(float3 linear_rgb) {
    float x = (0.4360747 * linear_rgb.r + 0.3850649 * linear_rgb.g + 0.1430804 * linear_rgb.b);
    float y = (0.2225045 * linear_rgb.r + 0.7168786 * linear_rgb.g + 0.0606169 * linear_rgb.b);
    float z = (0.0139322 * linear_rgb.r + 0.0971045 * linear_rgb.g + 0.7141733 * linear_rgb.b);
    return float3(x, y, z);
}

float3 d50xyz2linear(float3 xyz) {
    float r = (xyz.x *  3.1338561 + xyz.y * -1.6168667 + xyz.z * -0.4906146);
    float g = (xyz.x * -0.9787684 + xyz.y *  1.9161415 + xyz.z *  0.0334540);
    float b = (xyz.x *  0.0719453 + xyz.y * -0.2289914 + xyz.z *  1.4052427);
    return float3(r, g, b);
}

float3 linear2d65xyz(float3 linear_rgb) {
    float x = (0.4124564 * linear_rgb.r + 0.3575761 * linear_rgb.g + 0.1804375 * linear_rgb.b);
    float y = (0.2126729 * linear_rgb.r + 0.7151522 * linear_rgb.g + 0.0721750 * linear_rgb.b);
    float z = (0.0193339 * linear_rgb.r + 0.1191920 * linear_rgb.g + 0.9503041 * linear_rgb.b);
    return float3(x, y, z);
}

float3 d65xyz2linear(float3 xyz) {
    float r = (xyz.x *  3.2404542 + xyz.y * -1.5371385 + xyz.z * -0.4985314);
    float g = (xyz.x * -0.9692660 + xyz.y *  1.8760108 + xyz.z *  0.0415560);
    float b = (xyz.x *  0.0556434 + xyz.y * -0.2040259 + xyz.z *  1.0572252);
    return float3(r, g, b);
}

// ----------------------------------------------------------------------------
// CIELAB
// ----------------------------------------------------------------------------
// 参考: http://www.brucelindbloom.com/Eqn_XYZ_to_Lab.html
float xyz2lab_f(float x) {
    return x > 0.008856 ? pow(abs(x), 0.333333333) : (903.3 * x + 16.0) / 116.0;
}

float3 d50xyz2lab(float3 xyz) {
    float3 xyz_scaled = xyz / D50_WHITE;
    xyz_scaled = float3(
        xyz2lab_f(xyz_scaled.x),
        xyz2lab_f(xyz_scaled.y),
        xyz2lab_f(xyz_scaled.z)
    );
    return float3(
        (116.0 * xyz_scaled.y) - 16.0,
         500.0 * (xyz_scaled.x - xyz_scaled.y),
         200.0 * (xyz_scaled.y - xyz_scaled.z)
    );
}

float3 d65xyz2lab(float3 xyz) {
    float3 xyz_scaled = xyz / D65_WHITE;
    xyz_scaled = float3(
        xyz2lab_f(xyz_scaled.x),
        xyz2lab_f(xyz_scaled.y),
        xyz2lab_f(xyz_scaled.z)
    );
    return float3(
        (116.0 * xyz_scaled.y) - 16.0,
         500.0 * (xyz_scaled.x - xyz_scaled.y),
         200.0 * (xyz_scaled.y - xyz_scaled.z)
    );
}

// 参考: http://www.brucelindbloom.com/Eqn_Lab_to_XYZ.html
float lab2xyz_f(float x) {
    return pow(abs(x), 3.0) > 0.008856 ? pow(abs(x), 3.0) : (116.0 * x - 16.0) / 903.3;
}

float3 lab2d50xyz(float3 lab) {
    float f = (lab.x + 16.0) / 116.0;
    float y = lab.x > 0.008856 * 903.3 ? pow(abs((lab.x + 16.0) / 116.0), 3.0) : lab.x / 903.3;
    return D50_WHITE * float3(
        lab2xyz_f(f + lab.y / 500.0),
        y,
        lab2xyz_f(f - lab.z / 200.0)
    );
}

float3 lab2d65xyz(float3 lab) {
    float f = (lab.x + 16.0) / 116.0;
    float y = lab.x > 0.008856 * 903.3 ? pow(abs((lab.x + 16.0) / 116.0), 3.0) : lab.x / 903.3;
    return D65_WHITE * float3(
        lab2xyz_f(f + lab.y / 500.0),
        y,
        lab2xyz_f(f - lab.z / 200.0)
    );
}

float3 linear2d50lab(float3 linear_rgb) {
    float3 xyz = linear2d50xyz(linear_rgb);
    return d50xyz2lab(xyz);
}

float3 d50lab2linear(float3 lab) {
    float3 xyz = lab2d50xyz(lab);
    return d50xyz2linear(xyz);
}

float3 linear2d65lab(float3 linear_rgb) {
    float3 xyz = linear2d65xyz(linear_rgb);
    return d65xyz2lab(xyz);
}

float3 d65lab2linear(float3 lab) {
    float3 xyz = lab2d65xyz(lab);
    return d65xyz2linear(xyz);
}

// ----------------------------------------------------------------------------
// CIELCH
// ----------------------------------------------------------------------------
// 参考: http://www.brucelindbloom.com/Eqn_Lab_to_LCH.html
float3 lab2lch(float3 lab) {
    float chroma = length(float2(lab.y, lab.z));
    float hue = 0.0;
    // 無彩色でない場合のみHueを計算
    if (chroma > CHROMA_THRESHOLD) {
        hue = atan2(lab.z, lab.y);
        hue = hue < 0.0 ? hue + TAU : hue;
    }
    return float3(
        lab.x,
        chroma,
        hue
    );
}

// 参考: http://www.brucelindbloom.com/Eqn_LCH_to_Lab.html
float3 lch2lab(float3 lch) {
    return float3(
        lch.x,
        lch.y * cos(lch.z),
        lch.y * sin(lch.z)
    );
}

float3 linear2d50lch(in float3 linear_rgb) {
    float3 xyz = linear2d50xyz(linear_rgb);
    float3 lab = d50xyz2lab(xyz);
    return lab2lch(lab);
}

float3 d50lch2linear(in float3 lch) {
    float3 lab = lch2lab(lch);
    float3 xyz = lab2d50xyz(lab);
    return d50xyz2linear(xyz);
}

float3 linear2d65lch(in float3 linear_rgb) {
    float3 xyz = linear2d65xyz(linear_rgb);
    float3 lab = d65xyz2lab(xyz);
    return lab2lch(lab);
}

float3 d65lch2linear(in float3 lch) {
    float3 lab = lch2lab(lch);
    float3 xyz = lab2d65xyz(lab);
    return d65xyz2linear(xyz);
}

float3 lch_mix(float3 a, float3 b, float x, int interp_dir) {
    float lightness = lerp(a.x, b.x, x);
    float chroma = lerp(a.y, b.y, x);
    bool has_valid_hue1 = a.y > CHROMA_THRESHOLD;
    bool has_valid_hue2 = b.y > CHROMA_THRESHOLD;
    float hue = adjust_and_mix_hue(a.z, b.z, has_valid_hue1, has_valid_hue2, x, interp_dir);
    lightness = clamp(lightness, 0.0, 100.0);
    chroma = max(chroma, 0.0);
    return float3(lightness, chroma, hue);
}

// ----------------------------------------------------------------------------
// Oklab
// ----------------------------------------------------------------------------
float cbrt(float x) {
    return sign(x) * pow(abs(x), 1.0 / 3.0);
}

// 参考: https://bottosson.github.io/posts/oklab/#converting-from-linear-srgb-to-oklab
float3 linear2oklab(float3 linear_rgb) {
    float l = 0.4122214708 * linear_rgb.r + 0.5363325363 * linear_rgb.g + 0.0514459929 * linear_rgb.b;
	float m = 0.2119034982 * linear_rgb.r + 0.6806995451 * linear_rgb.g + 0.1073969566 * linear_rgb.b;
	float s = 0.0883024619 * linear_rgb.r + 0.2817188376 * linear_rgb.g + 0.6299787005 * linear_rgb.b;

    float l_ = cbrt(l);
    float m_ = cbrt(m);
    float s_ = cbrt(s);

    return float3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

// 参考: https://bottosson.github.io/posts/oklab/#converting-from-linear-srgb-to-oklab
float3 oklab2linear(float3 oklab) {
    float l_ = oklab.x + 0.3963377774 * oklab.y + 0.2158037573 * oklab.z;
    float m_ = oklab.x - 0.1055613458 * oklab.y - 0.0638541728 * oklab.z;
    float s_ = oklab.x - 0.0894841775 * oklab.y - 1.2914855480 * oklab.z;

    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;

    return float3(
		 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
		-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
		-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

// ----------------------------------------------------------------------------
// Oklch
// ----------------------------------------------------------------------------
float3 linear2oklch(float3 linear_rgb) {
    float3 oklab = linear2oklab(linear_rgb);
    return lab2lch(oklab);
}

float3 oklch2linear(float3 oklch) {
    float3 oklab = lch2lab(oklch);
    return oklab2linear(oklab);
}

float sd_circle(float2 uv, float r) {
    return length(uv) - r;
}

float sd_square(float2 uv) {
    uv *= sqrt(2.0);
    return max(abs(uv.x), abs(uv.y));
}

float sd_round_square(float2 uv, float2 b) {
    float2 dist = abs(uv) - b;
    float outside = length(max(dist, 0.0));
    float inside = min(max(dist.x, dist.y), 0.0);
    return outside + inside;
}

// smoothstep を掛ける前の 0..1（HLSL の smoothstep と同じ正規化）。
// 原作の形状の関数は smoothstep(e0, e1, x) を返していたが、多色化では区間ごとに
// smoothstep を掛けるので、形状の関数はこの線形な値を返す。
// 2 色なら区間が 0..1 の 1 つだけなので、psmain で掛ける t*t*(3-2t) と合わせて原作と同じ値になる。
float linstep(float edge0, float edge1, float x) {
    return saturate((x - edge0) / (edge1 - edge0));
}

float grad_line(float2 uv, float w) {
    w = max(1.0, w);
    return linstep(-w * 0.5, w * 0.5, uv.y);
}

float grad_circle(float2 uv, float w) {
    float dist = sd_circle(uv, w * 0.5);
    return linstep(-w * 0.5, w * 0.5, dist);
}

float grad_square(float2 uv, float w) {
    float dist = sd_square(uv);
    return linstep(0.0, w, dist);
}

float grad_convex(float2 uv, float w) {
    return linstep(0.0, w, abs(uv.y));
}

float grad_round_square(float2 uv, float w) {
    float dist = sd_round_square(uv, float2(w * 0.5, w * 0.5));
    return linstep(-w * 0.5, w * 0.5, dist);
}

float grad_circle_loop(float2 uv, float w) {
    w = max(1.0, w);
    float dist = sd_circle(uv, w);
    dist = fmod(dist + w, 2.0 * w) - w;
    return linstep(w, 0.0, abs(dist));
}

float grad_square_loop(float2 uv, float w) {
    w = max(1.0, w);
    float dist = sd_square(uv);
    dist = fmod(dist + w, 2.0 * w) - w;
    return linstep(0.0, w, abs(dist));
}

float grad_convex_loop(float2 uv, float w) {
    w = max(1.0, w);
    //float dist = mod(uv.y + w, 2.0 * w) - w;
    float dist = (uv.y + w - (2.0 * w) * floor((uv.y + w) / (2.0 * w))) - w;
    return linstep(0.0, w, abs(dist));
}

float grad_round_square_loop(float2 uv, float w) {
    w = max(1.0, w);
    float dist = sd_round_square(uv, w);
    dist = fmod(dist + w, 2.0 * w) - w;
    return linstep(0.0, w, abs(dist));
}

// ---- [v1.10 から] 段数とディザ（正本: 図形グラデーション_H の ps_sg_main。変えるときは両方を直す）----
// 段数 n（2 以上）: 位置 u を n 等分し、段 k（0..n-1）を位置 k/(n-1) にする（色ではなく位置を区切る）。
// ディザ: 段の番号 = floor(u x n - 0.5 + しきい値)。段の中心（u x n - 0.5 が整数）では混ざらず、
// 中心どうしの間で隣の段の割合が位置に比例して増える。なしは floor(u x n)（等幅の段）
uint grad_pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// しきい値（0..1）。1 = Bayer 8x8、2 = ノイズ（画素ごとの PCG ハッシュの上位 24 ビット）、それ以外は 0.5
float grad_dither_threshold(uint2 ip, float mode) {
    float thr = 0.5;
    if (mode > 1.5) {
        thr = (float)(grad_pcg_hash(ip.x + grad_pcg_hash(ip.y)) >> 8u) / 16777216.0;
    } else if (mode > 0.5) {
        uint x = ip.x & 7u;
        uint y = ip.y & 7u;
        uint xy = x ^ y;
        uint m = ((xy & 1u) << 5u) | ((y & 1u) << 4u) | ((xy & 2u) << 2u) | ((y & 2u) << 1u)
               | ((xy & 4u) >> 1u) | ((y & 4u) >> 2u);
        thr = ((float)m + 0.5) / 64.0;
    }
    return thr;
}

float grad_quantize(float u, float n, float mode, float thr) {
    float r = u;
    if (n > 1.5) {
        float lv = mode > 0.5 ? floor(u * n - 0.5 + thr) : floor(u * n);
        r = clamp(lv, 0.0, n - 1.0) / (n - 1.0);
    }
    return r;
}
// ---- [v1.10 まで] ----
Texture2D<float4> src : register(t0);
cbuffer constant0 : register(b0) {
    // ---- 0..21 は原作と同じ並び（Lua の配列の先頭 22 個も原作と同じ）----
    float2 resolution;    // 0-1
    float2 center;        // 2-3
    float4 color1;        // 4-7    開始色（rgb と不透明度）
    float4 color2;        // 8-11   終了色
    float2x2 angle;       // 12-13 と 16-17（行列の列は 16 バイト境界から始まるので 14-15 は詰め物）
    float color_space;    // 18
    float interp_dir;     // 19
    float gradient_type;  // 20
    float gradient_w;     // 21
    // ---- 22..36 は多色化で足した分。穴が出ない並びにしてある ----
    float stop1;          // 22     中間色1の位置（0..1）
    float stop2;          // 23     中間色2の位置
    float4 color_mid1;    // 24-27  中間色1（rgb と不透明度）
    float4 color_mid2;    // 28-31  中間色2
    float4 color_mid3;    // 32-35  中間色3
    float stop3;          // 36     中間色3の位置
    float step_count;     // 37     [v1.10] 段数（2 未満は連続）
    float dither_mode;    // 38     [v1.10] ディザ（0 なし / 1 Bayer / 2 ノイズ）
};

float4 ps_gradient(float4 pos : SV_Position) : SV_Target {
    float2 st = pos.xy - 0.5 * resolution - center;
    st = mul(angle, st);

    // 形状が作る 0..1 の線形な位置（smoothstep を掛ける前）
    float u = 0.0;
    switch (gradient_type) {
        case 0:  // 線形
            u = grad_line(st, gradient_w);
            break;
        case 1:  // 円形
            u = grad_circle(st, gradient_w);
            break;
        case 2:  // 矩形
            u = grad_square(st, gradient_w);
            break;
        case 3:  // 凸形
            u = grad_convex(st, gradient_w);
            break;
        case 4:  // 角丸矩形
            u = grad_round_square(st, gradient_w);
            break;
        case 5:  // 円ループ
            u = grad_circle_loop(st, gradient_w);
            break;
        case 6:  // 矩形ループ
            u = grad_square_loop(st, gradient_w);
            break;
        case 7:  // 凸形ループ
            u = grad_convex_loop(st, gradient_w);
            break;
        case 8:  // 角丸矩形ループ
            u = grad_round_square_loop(st, gradient_w);
            break;
        default:
            u = grad_line(st, gradient_w);
            break;
    }

    // [v1.10] 段数とディザ: 位置 u を段に区切ってから区間を探す
    if (step_count > 1.5) {  // [v1.10]
        u = grad_quantize(u, step_count, dither_mode, grad_dither_threshold(uint2(pos.xy), dither_mode));  // [v1.10]
    }  // [v1.10]

    // ---- 区間の探索 ----
    // 使わない中間色は Lua 側で「終了色・位置 1」に詰めてある。u は 1 を超えないので
    // その区間には入らず、色数による分岐は要らない。2 色なら常に「開始色→終了色、0..1」になる。
    // au2-hlsl-strict: ループと配列要素への代入を使わずに展開する。変数は宣言と同時に初期化する
    float4 col_a = color1;
    float4 col_b = color_mid1;
    float pos_a = 0.0;
    float pos_b = stop1;
    if (u > stop1) {
        col_a = color_mid1;
        col_b = color_mid2;
        pos_a = stop1;
        pos_b = stop2;
    }
    if (u > stop2) {
        col_a = color_mid2;
        col_b = color_mid3;
        pos_a = stop2;
        pos_b = stop3;
    }
    if (u > stop3) {
        col_a = color_mid3;
        col_b = color2;
        pos_a = stop3;
        pos_b = 1.0;
    }
    // 区間内の位置。長さ 0 の区間（同じ位置に 2 色）は後ろの色にする
    float seg_t = 1.0;
    if (pos_b - pos_a > 1e-6) {
        seg_t = saturate((u - pos_a) / (pos_b - pos_a));
    }
    // 原作の smoothstep と同じ補間を区間ごとに掛ける
    float t = seg_t * seg_t * (3.0 - 2.0 * seg_t);

    float3 col1 = col_a.rgb;
    float3 col2 = col_b.rgb;
    float alpha1 = col_a.a;
    float alpha2 = col_b.a;
    float3 result = float3(0.0, 0.0, 0.0);
    float mixed_alpha = max(alpha_mix(alpha1, alpha2, t), 1e-6);
    switch (color_space) {
        case 0:  // sRGB
        {
            float3 premulti_srgb1 = col1 * alpha1;
            float3 premulti_srgb2 = col2 * alpha2;
            float3 mixed_srgb = lerp(premulti_srgb1, premulti_srgb2, t);
            float3 unpremulti_srgb = mixed_srgb / mixed_alpha;
            result = unpremulti_srgb;
            break;
        }
        case 1:  // Linear sRGB
        {
            float3 premulti_linear1 = srgb2linear(col1) * alpha1;
            float3 premulti_linear2 = srgb2linear(col2) * alpha2;
            float3 mixed_linear = lerp(premulti_linear1, premulti_linear2, t);
            float3 unpremulti_linear = mixed_linear / mixed_alpha;
            result = linear2srgb(clamp(unpremulti_linear, 0.0, 1.0));
            break;
        }
        case 2:  // HSV
        {
            float3 hsv1 = srgb2hsv(col1);
            float3 hsv2 = srgb2hsv(col2);

            // 片方が透明であってもその色が持っているHueを維持してグラデーションを作るために、
            // アルファを掛ける前の彩度で無彩色かどうかを判定する
            bool has_valid_hue1 = hsv1.y > SATURATION_THRESHOLD;
            bool has_valid_hue2 = hsv2.y > SATURATION_THRESHOLD;
            float mixed_hue = adjust_and_mix_hue(hsv1.x, hsv2.x, has_valid_hue1, has_valid_hue2, t, interp_dir);

            // 彩度と明度はアルファを掛けた後で補間する
            float2 sv1 = hsv1.yz * alpha1;
            float2 sv2 = hsv2.yz * alpha2;
            float2 mixed_sv = lerp(sv1, sv2, t);
            mixed_sv /= mixed_alpha;

            // 結果の色を合成
            float3 result_hsv = float3(mixed_hue, mixed_sv);
            result = hsv2srgb(result_hsv);
            break;
        }
        case 3:  // HSL
        {
            float3 hsl1 = srgb2hsl(col1);
            float3 hsl2 = srgb2hsl(col2);

            bool has_valid_hue1 = hsl1.y > SATURATION_THRESHOLD;
            bool has_valid_hue2 = hsl2.y > SATURATION_THRESHOLD;
            float mixed_hue = adjust_and_mix_hue(hsl1.x, hsl2.x, has_valid_hue1, has_valid_hue2, t, interp_dir);

            float2 sl1 = hsl1.yz * alpha1;
            float2 sl2 = hsl2.yz * alpha2;
            float2 mixed_sl = lerp(sl1, sl2, t);
            mixed_sl /= mixed_alpha;

            float3 result_hsl = float3(mixed_hue, mixed_sl);
            result = hsl2srgb(result_hsl);
            break;
        }
        case 4:  // L*a*b* (CIELAB)
        {
            // D50基準
            float3 lab1 = linear2d50lab(srgb2linear(col1));
            float3 lab2 = linear2d50lab(srgb2linear(col2));
            float3 premulti_lab1 = lab1 * alpha1;
            float3 premulti_lab2 = lab2 * alpha2;
            float3 mixed_lab = lerp(premulti_lab1, premulti_lab2, t);
            float3 unpremulti_lab = mixed_lab / mixed_alpha;
            result = linear2srgb(clamp(d50lab2linear(unpremulti_lab), 0.0, 1.0));
            break;
        }
        case 5:  // LCh
        {
            // D50基準
            float3 lch1 = linear2d50lch(srgb2linear(col1));
            float3 lch2 = linear2d50lch(srgb2linear(col2));

            bool has_valid_hue1 = lch1.y > CHROMA_THRESHOLD;
            bool has_valid_hue2 = lch2.y > CHROMA_THRESHOLD;
            float mixed_hue = adjust_and_mix_hue(lch1.z, lch2.z, has_valid_hue1, has_valid_hue2, t, interp_dir);

            float2 lc1 = lch1.xy * alpha1;
            float2 lc2 = lch2.xy * alpha2;
            float2 mixed_lc = lerp(lc1, lc2, t);
            mixed_lc = mixed_lc / mixed_alpha;

            mixed_lc.x = clamp(mixed_lc.x, 0.0, 100.0);
            mixed_lc.y = max(mixed_lc.y, 0.0);

            float3 result_lch = float3(mixed_lc.x, mixed_lc.y, mixed_hue);
            result = linear2srgb(clamp(d50lch2linear(result_lch), 0.0, 1.0));
            break;
        }
        case 6:  // Oklab
        {
            float3 oklab1 = linear2oklab(srgb2linear(col1));
            float3 oklab2 = linear2oklab(srgb2linear(col2));
            float3 premulti_oklab1 = oklab1 * alpha1;
            float3 premulti_oklab2 = oklab2 * alpha2;
            float3 mixed_oklab = lerp(premulti_oklab1, premulti_oklab2, t);
            float3 unpremulti_oklab = mixed_oklab / mixed_alpha;
            result = linear2srgb(clamp(oklab2linear(unpremulti_oklab), 0.0, 1.0));
            break;
        }
        case 7:  // OkLCh
        {
            float3 oklch1 = linear2oklch(srgb2linear(col1));
            float3 oklch2 = linear2oklch(srgb2linear(col2));

            bool has_valid_hue1 = oklch1.y > CHROMA_THRESHOLD;
            bool has_valid_hue2 = oklch2.y > CHROMA_THRESHOLD;
            float mixed_hue = adjust_and_mix_hue(oklch1.z, oklch2.z, has_valid_hue1, has_valid_hue2, t, interp_dir);

            float2 lc1 = oklch1.xy * alpha1;
            float2 lc2 = oklch2.xy * alpha2;
            float2 mixed_lc = lerp(lc1, lc2, t);
            mixed_lc = mixed_lc / mixed_alpha;

            mixed_lc.x = clamp(mixed_lc.x, 0.0, 1.0);
            mixed_lc.y = max(mixed_lc.y, 0.0);

            float3 result_oklch = float3(mixed_lc.x, mixed_lc.y, mixed_hue);
            result = linear2srgb(clamp(oklch2linear(result_oklch), 0.0, 1.0));
            break;
        }
    }

    return float4(result * mixed_alpha, mixed_alpha);
}

]]

--[[pixelshader@ps_opaque:
// 素材を不透明にする（v1.01）: rgb = ストレートの色（乗算済みを α で割る）、α = 1。
// α = 0 の画素は色を持たないので黒にする（最後に α 0 で切り抜くので見えない）。
// 書き込み先は 16bit float なので、α がごく小さいのに RGB が大きい壊れた画素で
// 無限大にならないよう半精度の最大値で抑える（RGB <= α の正しい画素には効かない）
static const float HALF_MAX = 65504.0;
Texture2D<float4> src_tex : register(t0);
float4 ps_opaque(float4 pos : SV_Position) : SV_Target {
    float4 px = src_tex.Load(int3(pos.xy, 0));
    if (px.a <= 0.0) {
        return float4(0.0, 0.0, 0.0, 1.0);
    }
    float3 rgb = clamp(px.rgb / px.a, -HALF_MAX, HALF_MAX);
    return float4(rgb, 1.0);
}
]]

--[[pixelshader@ps_restore:
// 合成した結果 T'（t0）のストレートの色に、元の素材（t1）のアルファを掛け直す（v1.01）。
// T' は不透明にした素材の上で合成したので α = 1 のはずだが、合成モードの扱いで 1 から
// ずれても色だけを取り出せるよう T'.a で割る。"copy" で書くので素材の α がそのまま残る
Texture2D<float4> blended_tex : register(t0);
Texture2D<float4> source_tex : register(t1);
float4 ps_restore(float4 pos : SV_Position) : SV_Target {
    float4 t = blended_tex.Load(int3(pos.xy, 0));
    float4 o = source_tex.Load(int3(pos.xy, 0));
    if (o.a <= 0.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }
    float3 rgb = t.rgb / max(t.a, 1e-6) * o.a;
    return float4(rgb, o.a);
}
]]

local function rotate(deg)
  local rad = math.rad(deg)
  return { math.cos(rad), -math.sin(rad),
           math.sin(rad), math.cos(rad) }
end

if gradient_type == 2 or gradient_type == 4 or gradient_type == 6 or gradient_type == 8 then
  angle = angle - 45
end

local r1, g1, b1 = RGB(color1)
local r2, g2, b2 = RGB(color2)
local m00, m01, m10, m11 = unpack(rotate(angle))

-- v1.02: 幅の基準 = 画像サイズ。形状の 0〜100% がオブジェクトの端から端まで届く幅を、4 隅から求める。
-- st = mul(angle, p) で、float2x2 は列優先で渡るので st.x = m00*x + m10*y、st.y = m01*x + m11*y。
-- 各形状で「その隅で位置がちょうど 1 になる幅」を出し、いちばん大きいものを採る（ループは同じ形のループ無しと同じ）
local width = gradient_w
if w_basis == 1 then
  local reach = 0
  local t = gradient_type
  for _, sgn in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
    local x0 = sgn[1] * obj.w * 0.5 - center_x
    local y0 = sgn[2] * obj.h * 0.5 - center_y
    local x = m00 * x0 + m10 * y0
    local y = m01 * x0 + m11 * y0
    local ax, ay = math.abs(x), math.abs(y)
    local r
    if t == 0 then
      r = 2 * ay                                  -- 線形: 幅全体で 0→1（中心の両側に半分ずつ）
    elseif t == 1 or t == 5 then
      r = math.sqrt(x * x + y * y)                -- 円形: 半径 = 幅
    elseif t == 2 or t == 6 then
      r = math.sqrt(2) * math.max(ax, ay)         -- 矩形: sd_square が幅で 1
    elseif t == 3 or t == 7 then
      r = ay                                      -- 凸形: |y| = 幅で 1
    else
      -- 角丸矩形: sd_round_square(q, 幅/2) = 幅/2 を解く（a >= b）
      local a, b = math.max(ax, ay), math.min(ax, ay)
      if b <= a * 0.5 then
        r = a
      else
        r = 2 * ((a + b) - math.sqrt(2 * a * b))
      end
    end
    reach = math.max(reach, r)
  end
  width = reach * math.max(0, gradient_pct or 100) / 100
end
local a1 = 1 - alpha1 / 100
local a2 = 1 - alpha2 / 100
local PAD = 0.0

-- 中間色。色数 n なら中間色 1〜(n-2) を使う
local n_colors = math.min(math.max(math.floor(color_count + 0.5), 2), 5)
local n_mid = n_colors - 2
local mid_color = { color_mid1, color_mid2, color_mid3 }
local mid_alpha = { alpha_mid1, alpha_mid2, alpha_mid3 }
local mid_pos = { pos_mid1, pos_mid2, pos_mid3 }

local mids, stops = {}, {}
local prev_stop = 0.0
for k = 1, 3 do
  if k <= n_mid then
    local r, g, b = RGB(mid_color[k])
    mids[k] = { r / 255.0, g / 255.0, b / 255.0, 1 - mid_alpha[k] / 100 }
    local s = mid_pos[k] / 100
    if even_stops == 1 then
      s = k / (n_colors - 1)
    end
    -- 前の色より手前には置かない（CSS のグラデーションと同じ扱い）。0..1 に収める
    s = math.min(math.max(s, prev_stop), 1.0)
    stops[k] = s
    prev_stop = s
  else
    -- 使わない中間色は終了色・位置 1 で埋める。シェーダーはこの区間に入らない
    mids[k] = { r2 / 255.0, g2 / 255.0, b2 / 255.0, a2 }
    stops[k] = 1.0
  end
end

-- v1.03: 元の素材の退避。cache と tempbuffer は合わせて 1600 万ドットの枠を共有し、超えると最も古いものから
-- 黙って捨てられる。v1.02 はオブジェクトごとに名前を変えて（orig_<obj.id>）使い終えても残していたので、
-- テキストを並べたグループ制御に掛けて描き直すと、前の描画から残った自分の退避が最も古くなり、
-- tempbuffer を作り直した拍子に消えて invalid buffer type になった（実制作で 2 回。
-- AI/scripts/issues/20260925_gradient_orig_cache_evicted_on_rerender.md）。
-- 名前を 1 つにし、tempbuffer を先に作ってから退避し（退避の後に確保を挟まない）、読み終えたら縮める
local cache_name = "cache:multigradient_h/orig"

obj.setoption("drawtarget", "tempbuffer", obj.w, obj.h)
obj.copybuffer(cache_name, "object")
-- v1.01: 素材を不透明にしてから合成する。原作はここで半透明のまま仮想バッファへ置き、
-- その上に「素材にグラデーションを重ねたもの」を重ねるので、強さ < 100 で縁の素材を二重に数えていた
obj.pixelshader("ps_opaque", "object", { "object" }, {}, "copy")
obj.draw()

-- 先頭 22 個は原作と同じ並び。22 以降は cbuffer の stop1 .. stop3、step_count / dither_mode（v1.10。穴なし）
obj.pixelshader(
  "ps_gradient", "object", { "object" },
  {
    obj.w, obj.h,
    center_x, center_y,
    r1 / 255.0, g1 / 255.0, b1 / 255.0, a1,
    r2 / 255.0, g2 / 255.0, b2 / 255.0, a2,
    m00, m01, PAD, PAD,
    m10, m11,
    color_space,
    interp_dir,
    gradient_type,
    width,
    stops[1], stops[2],
    mids[1][1], mids[1][2], mids[1][3], mids[1][4],
    mids[2][1], mids[2][2], mids[2][3], mids[2][4],
    mids[3][1], mids[3][2], mids[3][3], mids[3][4],
    stops[3],
    math.floor((grad_steps or 0) + 0.5),   -- [v1.10] 段数（2 未満は連続）
    grad_dither or 0,                      -- [v1.10] ディザ
  },
  "draw"
)

obj.setoption("blend", blend_mode)
obj.draw(0.0, 0.0, 0.0, 1.0, strength / 100.0)

obj.setoption("blend", "none")
-- 原作は obj.copybuffer("obj", "tmp")。lua.txt の一覧にある正式名に直した
obj.copybuffer("object", "tempbuffer")

-- 合成結果のストレートの色に元のオブジェクトのアルファを掛け直す（v1.01）。
-- 原作はここで "mask"（書き込み先の RGBA に参照元の α を掛ける。実機 GRD-06 で確認）を使うので、
-- 結果の α は「合成結果の α x 素材の α」になり、半透明の縁で素材の α を二重に掛けていた
obj.pixelshader("ps_restore", "object", { "object", cache_name }, {}, "copy")
-- 読み終えた退避は縮めて枠を空ける（次に書くときは必ず作り直しになり、最も新しいものとして数えられる。v1.03）
obj.clearbuffer(cache_name, 1, 1)

